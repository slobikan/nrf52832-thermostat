<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_logo_plate">

                    <ImageView
                        android:id="@+id/headerLogoIcon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="8dp"
                        android:src="@drawable/ic_ajax_peak"
                        android:tint="@android:color/black" />

                    <TextView
                        android:id="@+id/headerLogoText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="7dp"
                        android:text="AJAX"
                        android:textColor="@android:color/black"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/frost_050"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/headerModeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/mode_auto"
                        android:textColor="@color/frost_200"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/menuButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/menu_open"
                    android:padding="12dp"
                    android:src="@drawable/ic_menu_bars"
                    android:tint="@color/frost_050" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/main_screen_zones"
                android:textColor="@color/frost_050"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/zoneGridContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/summaryCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/panel_900"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/panel_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/sourceBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_signal_chip"
                            android:paddingLeft="12dp"
                            android:paddingTop="7dp"
                            android:paddingRight="12dp"
                            android:paddingBottom="7dp"
                            android:text="@string/source_demo"
                            android:textColor="@color/frost_050"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/pairStatusValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="@string/pair_waiting"
                            android:textColor="@color/frost_100" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/currentTempValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="23°C"
                        android:textColor="@color/frost_050"
                        android:textSize="54sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/systemStatusValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/status_idle"
                        android:textColor="@color/frost_100"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lastUpdatedValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/last_updated_placeholder"
                        android:textColor="@color/frost_200"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_signal_chip"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/target_temperature"
                                android:textColor="@color/frost_200"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/targetTempValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="22°C"
                                android:textColor="@color/brand_orange_100"
                                android:textSize="24sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_signal_chip"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/displayed_zones"
                                android:textColor="@color/frost_200"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/zoneCountSummaryValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="1"
                                android:textColor="@color/frost_050"
                                android:textSize="24sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.slider.Slider
                        android:id="@+id/setpointSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:value="22"
                        app:haloColor="@color/brand_orange_300"
                        app:thumbColor="@color/brand_orange_300"
                        app:trackColorActive="@color/brand_orange_300"
                        app:trackColorInactive="@color/panel_stroke" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/applyButton"
                            style="@style/Widget.MaterialComponents.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/apply_setpoint"
                            android:textAllCaps="false"
                            app:backgroundTint="@color/brand_orange_300"
                            app:cornerRadius="16dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/refreshButton"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/sync_now"
                            android:textAllCaps="false"
                            app:cornerRadius="16dp"
                            app:strokeColor="@color/brand_teal_300" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/pairButton"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="@string/pair_receiver"
                            android:textAllCaps="false"
                            app:cornerRadius="16dp"
                            app:strokeColor="@color/frost_100" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/editorCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="18dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/panel_850"
                app:cardCornerRadius="28dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/panel_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/editorTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/menu_zones"
                        android:textColor="@color/frost_050"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/editorSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/editor_default_subtitle"
                        android:textColor="@color/frost_200"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/zonesSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/zoneSelectionControls"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/zones_select_title"
                                android:textColor="@color/frost_050"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/displayed_zones"
                                android:textColor="@color/frost_100"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/zoneCountValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="1"
                                android:textColor="@color/brand_orange_100"
                                android:textSize="22sp"
                                android:textStyle="bold" />

                            <com.google.android.material.slider.Slider
                                android:id="@+id/zoneCountSlider"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:value="1"
                                app:haloColor="@color/brand_teal_300"
                                app:thumbColor="@color/brand_teal_300"
                                app:trackColorActive="@color/brand_teal_300"
                                app:trackColorInactive="@color/panel_stroke" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:text="@string/chronogram_title"
                            android:textColor="@color/frost_050"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/zone_schedule_zone"
                            android:textColor="@color/frost_100"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/zoneScheduleName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_signal_chip"
                            android:padding="12dp"
                            android:text="@string/zone_schedule_placeholder"
                            android:textColor="@color/frost_050"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/zoneSelectorSpinner"
                            android:layout_width="1dp"
                            android:layout_height="1dp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/schedule_1"
                                    android:textColor="@color/frost_100"
                                    android:textStyle="bold" />

                                <Button
                                    android:id="@+id/schedule1StartButton"
                                    android:layout_width="88dp"
                                    android:layout_height="wrap_content"
                                    android:text="00:00" />

                                <Button
                                    android:id="@+id/schedule1EndButton"
                                    android:layout_width="88dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="23:59" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/schedule_2"
                                    android:textColor="@color/frost_100"
                                    android:textStyle="bold" />

                                <Button
                                    android:id="@+id/schedule2StartButton"
                                    android:layout_width="88dp"
                                    android:layout_height="wrap_content"
                                    android:text="00:00" />

                                <Button
                                    android:id="@+id/schedule2EndButton"
                                    android:layout_width="88dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="23:59" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/schedule_3"
                                    android:textColor="@color/frost_100"
                                    android:textStyle="bold" />

                                <Button
                                    android:id="@+id/schedule3StartButton"
                                    android:layout_width="88dp"
                                    android:layout_height="wrap_content"
                                    android:text="00:00" />

                                <Button
                                    android:id="@+id/schedule3EndButton"
                                    android:layout_width="88dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="23:59" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/modeSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <CheckBox
                            android:id="@+id/coolingCheck"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/frost_050"
                            android:text="@string/mode_cooling"
                            android:textColor="@color/frost_050" />

                        <CheckBox
                            android:id="@+id/heatingCheck"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:buttonTint="@color/frost_050"
                            android:text="@string/mode_heating"
                            android:textColor="@color/frost_050" />

                        <CheckBox
                            android:id="@+id/autoCheck"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:buttonTint="@color/frost_050"
                            android:text="@string/mode_auto_hysteresis"
                            android:textColor="@color/frost_050" />

                        <CheckBox
                            android:id="@+id/ventilationCheck"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:buttonTint="@color/frost_050"
                            android:text="@string/mode_ventilation"
                            android:textColor="@color/frost_050" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/settingsSection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/wifi_settings_title"
                            android:textColor="@color/frost_050"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/wifiSsidLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:hint="@string/wifi_ssid"
                            app:boxBackgroundColor="@color/panel_700"
                            app:boxStrokeColor="@color/panel_stroke">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/wifiSsidInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/frost_050" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/wifiPasswordLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="@string/wifi_password"
                            app:boxBackgroundColor="@color/panel_700"
                            app:boxStrokeColor="@color/panel_stroke">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/wifiPasswordInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textPassword"
                                android:textColor="@color/frost_050" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/gatewayInputLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="@string/gateway_url"
                            app:boxBackgroundColor="@color/panel_700"
                            app:boxStrokeColor="@color/panel_stroke">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/gatewayUrlInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textUri"
                                android:textColor="@color/frost_050" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <Switch
                            android:id="@+id/dhcpSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/wifi_dhcp"
                            android:textColor="@color/frost_050" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/ipAddressLayout"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:hint="@string/wifi_ip"
                            app:boxBackgroundColor="@color/panel_700"
                            app:boxStrokeColor="@color/panel_stroke">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/ipAddressInput"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:textColor="@color/frost_050" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/language_title"
                            android:textColor="@color/frost_100"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/languageSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_signal_chip"
                            android:popupBackground="@drawable/bg_popup_menu"
                            android:spinnerMode="dropdown" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/statusValue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/status_ready"
                        android:textColor="@color/frost_200"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
