<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_zone_dialog_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_zone_dialog_icon">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_ajax_peak"
            android:tint="@android:color/white" />
    </FrameLayout>

    <TextView
        android:id="@+id/zonePanelName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_zone_dialog_header"
        android:gravity="center"
        android:padding="10dp"
        android:textColor="@android:color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#EFEFEF"
        android:gravity="center"
        android:padding="8dp"
        android:text="@string/zone_panel_constant_temperature"
        android:textColor="#666666"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/zonePanelCurrentTemp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/storm_950"
        android:textSize="42sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/zonePanelSetpointValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/panel_stroke"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/zone_panel_min"
            android:textColor="#666666"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/zone_panel_max"
            android:textColor="#666666"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.google.android.material.slider.Slider
        android:id="@+id/zonePanelSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:haloColor="@color/brand_orange_300"
        app:thumbColor="@color/brand_orange_300"
        app:trackColorActive="@color/brand_orange_300"
        app:trackColorInactive="#D5D5D5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/zonePanelDecreaseButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:text="-"
            android:textColor="#888888"
            android:textSize="28sp"
            app:cornerRadius="26dp"
            app:strokeColor="#D0D0D0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/zonePanelIncreaseButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="18dp"
            android:text="+"
            android:textColor="#888888"
            android:textSize="28sp"
            app:cornerRadius="26dp"
            app:strokeColor="#D0D0D0" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/zonePanelCloseButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="@drawable/bg_zone_dialog_action_danger"
            android:contentDescription="@string/zone_panel_close"
            android:padding="14dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/zonePanelChronogramButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_zone_dialog_action_primary"
            android:contentDescription="@string/zone_panel_open_chronogram"
            android:padding="14dp"
            android:src="@android:drawable/ic_menu_recent_history"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/zonePanelConfirmButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_zone_dialog_action_primary"
            android:contentDescription="@string/zone_panel_confirm"
            android:padding="14dp"
            android:src="@android:drawable/checkbox_on_background"
            android:tint="@android:color/white" />
    </LinearLayout>
</LinearLayout>
