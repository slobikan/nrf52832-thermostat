<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TermostatAndroid" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_orange_300</item>
        <item name="colorPrimaryVariant">@color/brand_orange_400</item>
        <item name="colorSecondary">@color/brand_teal_300</item>
        <item name="colorSecondaryVariant">@color/brand_teal_400</item>
        <item name="colorSurface">@color/panel_900</item>
        <item name="android:colorBackground">@color/storm_950</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/storm_900</item>
    </style>

    <style name="TextAppearanceTermostatAndroidPopupMenu" parent="TextAppearance.AppCompat.Widget.PopupMenu.Large">
        <item name="android:textColor">@color/frost_050</item>
    </style>

    <style name="ThemeOverlayTermostatAndroidPopupMenu" parent="ThemeOverlay.AppCompat.Dark">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:textColorPrimary">@color/frost_050</item>
        <item name="colorControlNormal">@color/frost_050</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearanceTermostatAndroidPopupMenu</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearanceTermostatAndroidPopupMenu</item>
    </style>
</resources>
